# Verilənlər bazası. SQLite faylı prisma/solo.db-də yaranır.
# PostgreSQL üçün: DATABASE_URL="postgresql://istifadeci:sifre@localhost:5432/solo" (README-yə bax)
DATABASE_URL="file:./solo.db"

# Sessiya şifrələmə açarı. MÜTLƏQ doldurun: openssl rand -hex 32
AUTH_SECRET=""

# Saat qurşağı — tarixlər server və brauzerdə eyni görünsün
TZ="Asia/Baku"

# Yalnız HTTPS olmadan (IP ilə / daxili şəbəkədə) production rejimində işlədirsinizsə açın:
# INSECURE_COOKIES=1
